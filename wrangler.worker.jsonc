{
  // Explicit filename keeps Vinext static export separate from its SSR deployment integration.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dovan",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/health"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clan-archive",
      "database_id": "f94b8018-76ea-4a8f-a42f-5848fd8feb0b",
      "migrations_dir": "db/d1-migrations",
    },
  ],
  "observability": { "enabled": true },
}
