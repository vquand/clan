{
  "name": "clan-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start:api": "node server/index.mjs",
    "db:migrate": "wrangler --config wrangler.worker.jsonc d1 migrations apply DB --local",
    "db:seed": "node scripts/d1-data.mjs seed",
    "lint": "oxlint",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "validate:data": "node scripts/validate-data.ts",
    "format": "oxfmt",
    "dev:worker": "wrangler --config wrangler.worker.jsonc dev --port 8787",
    "deploy": "npm run build && wrangler --config wrangler.worker.jsonc deploy",
    "deploy:check": "wrangler --config wrangler.worker.jsonc deploy --dry-run --outdir dist/worker",
    "db:migrate:remote": "wrangler --config wrangler.worker.jsonc d1 migrations apply DB --remote",
    "db:export:neon": "node --env-file-if-exists=.env scripts/export-neon.mjs",
    "db:convert": "node scripts/d1-data.mjs convert",
    "db:verify": "node scripts/d1-data.mjs verify",
    "db:migrate:neon": "node scripts/migrate-db.mjs",
    "db:seed:neon": "node scripts/seed-db.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "fast-glob": "file:compat/fast-glob",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.73.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "^4.164.0",
    "@neondatabase/serverless": "^1.1.0"
  },
  "overrides": {
    "fast-glob": "$fast-glob"
  },
  "type": "module"
}
