# Frontend (Vercel): public base URL of the Render API service.
NEXT_PUBLIC_API_URL=http://localhost:10000

# Backend (Render/local API): Neon Postgres connection string.
DATABASE_URL=

# Backend CORS allowlist. Use the exact Vercel URL(s) in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# One-time database seed input. Do not commit real clan data.
# Paste a minified JSON object matching examples/clan-data.example.json.
CLAN_DATA_JSON=
# Or point the validation/seed scripts at a private file outside this repo.
CLAN_DATA_FILE=
