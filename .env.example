# Public family name, embedded when building the static frontend.
CLAN_DISPLAY_NAME=Nguyễn Văn
# Optional standalone fictional demo. Leave false for Cloudflare/D1 deployments.
CLAN_DEMO=false

# One-time private seed input. Never commit real clan records.
CLAN_DATA_FILE=
