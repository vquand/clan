# Frontend (Vercel): public base URL of the Render API service.
NEXT_PUBLIC_API_URL=http://localhost:10000
# Frontend (Vercel/local build): the family name shown in the tab, header, and loading screen.
CLAN_DISPLAY_NAME=Đỗ Văn

# Backend (Render/local API): Neon Postgres connection string.
DATABASE_URL=

# Backend CORS allowlist. Use the exact Vercel URL(s) in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Backend admin access. Keep these values only on the Render/API service.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: a separate long random value for signing admin session cookies.
# If omitted, ADMIN_PASSWORD is used as the signing secret.
ADMIN_SESSION_SECRET=

# One-time database seed input. Do not commit real clan data.
# Paste a minified JSON object matching examples/clan-data.example.json.
CLAN_DATA_JSON=
# Or point the validation/seed scripts at a private file outside this repo.
CLAN_DATA_FILE=
